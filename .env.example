# -----------------------------------------------
# EduNest AI - Environment Variables Reference
# Copy this file and fill in your real values.
# NEVER commit your real .env files to Git.
# -----------------------------------------------

# --- SERVER ---
PORT=5000

# --- DATABASE ---
# MongoDB connection string (from MongoDB Atlas or local MongoDB)
MONGO_URI=your_mongodb_connection_string_here

# --- AUTHENTICATION ---
# A long random secret string used to sign JWT tokens
# You can generate one at: https://generate-secret.vercel.app/32
JWT_SECRET=your_jwt_secret_here

# --- AI ASSISTANT ---
# Google Gemini API key (from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

